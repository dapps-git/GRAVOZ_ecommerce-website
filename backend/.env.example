PORT=5000
NODE_ENV=production
MONGODB_URI=your_mongodb_uri
JWT_SECRET=your_jwt_secret

# Admin Credentials
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password
ADMIN_PASSWORD_HASH=your_admin_password_hash

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend & Admin URLs (CORS)
CLIENT_URL=https://gravoz-ecommerce-website.vercel.app
ADMIN_URL=https://gravoz-ecommerce-website-gxy1.vercel.app

# SMTP Email Configuration
SMTP_EMAIL=your_smtp_email
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME=GRAVOZ Store
